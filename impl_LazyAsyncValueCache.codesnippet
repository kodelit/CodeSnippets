	<key>IDECodeSnippetSummary</key>
	<string>Lazy loaded value, removed on memory warning, denends on LazyAsyncValue implementation</string>
	<key>IDECodeSnippetTitle</key>
	<string>Impl: LazyAsyncValueCache</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
