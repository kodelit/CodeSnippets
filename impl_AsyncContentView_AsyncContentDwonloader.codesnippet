	<key>IDECodeSnippetSummary</key>
	<string>View which is presenting placeholder untill the content is downloaded.</string>
	<key>IDECodeSnippetTitle</key>
	<string>Impl: AsyncContentView and AsyncContentDwonloader</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
